  m_Script: {fileID: 11500000, guid: 9f4c1fcca8a2c114fa637da1c4786c71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _targets:
  - Target: {fileID: 981249603}
    Description: "\uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uC2DC\uAC04\uACFC \uC810\uC218\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4.\r\n\uC810\uC218\uB97C \uC5BB\uC5B4 \uB7AD\uD06C\uB97C
      \uB2EC\uC131\uD558\uACE0, \uB2A5\uB825\uC744 \uD574\uAE08\uD558\uC138\uC694!\r\n\uC801\uC5D0\uAC8C
      \uD53C\uACA9 \uC2DC \uD50C\uB808\uC774 \uC2DC\uAC04\uC774 \uAC10\uC18C\uD569\uB2C8\uB2E4.\r\n\uC2DC\uAC04\uC774
      \uC9C0\uB0A0\uC218\uB85D \uCC98\uCE58\uB85C \uC5BB\uB294 \uC2DC\uAC04\uC774
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - Target: {fileID: 1342710434}
    Description: "\uCD1D \uD50C\uB808\uC774 \uD0C0\uC784\uACFC \uB2EC\uC131\uD55C
      \uCD5C\uACE0 \uC810\uC218\uAC00 \uB098\uC635\uB2C8\uB2E4"
  - Target: {fileID: 596144302}
    Description: "\uC801\uC744 \uD0C0\uACA9\uD560 \uB54C \uB9C8\uB2E4 \uCF64\uBCF4\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4.\r\nNice ~ Perfect \uC758 \uCF64\uBCF4 \uB4F1\uAE09\uC774
      \uC788\uC73C\uBA70 \uCF64\uBCF4 \uB4F1\uAE09\uC774 \uC62C\uB77C\uAC08 \uC218\uB85D
      \uC801\uC5D0\uAC8C \uC8FC\uB294 \uD53C\uD574\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Target: {fileID: 1205464673}
    Description: "\uBBF8\uB2C8\uB9F5\uC73C\uB85C \uC8FC\uBCC0 \uC801\uC758 \uC704\uCE58\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Target: {fileID: 1772574091}
    Description: "\uC801\uC758 \uACF5\uACA9\uC744 \uB9C9\uC744 \uC218 \uC788\uB294
      \uAC00\uB4DC \uAC8C\uC774\uC9C0\uC785\uB2C8\uB2E4.\r\n\uAC8C\uC774\uC9C0 \uCD1D\uB7C9\uC744
      100\uC774\uBA70 \uAC00\uB4DC\uB85C \uC801\uC758 \uACF5\uACA9\uC744 \uB9C9\uC744
      \uB54C \uB9C8\uB2E4 10 \uC18C\uBAA8\uB429\uB2C8\uB2E4.\r\n\uAC00\uB4DC\uB97C
      \uD574\uC81C\uD558\uACE0 \uC788\uC73C\uBA74 \uC11C\uC11C\uD788 \uD68C\uBCF5\uB429\uB2C8\uB2E4"
  - Target: {fileID: 2147193060}
    Description: "\uC2A4\uD0AC \uCFE8\uD0C0\uC784 \uC815\uBCF4\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Target: {fileID: 839784343}
    Description: "\uCC98\uCE58\uD55C \uC801\uC758 \uC815\uBCF4\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
